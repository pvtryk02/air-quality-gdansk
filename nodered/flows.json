        "id": "e25d29daf91f73e8",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Build measurement",
        "func": "if (!msg.payload.pm10 || !msg.payload.pm25) {\n    node.warn(\"Brakuje PM10 lub PM2.5\");\n    return null;\n}\n\nmsg.payload = {\n    station_code: \"PmGdaWyzwole\",\n    measured_at: msg.payload.pm10.measured_at,\n    pm25: msg.payload.pm25.value,\n    pm10: msg.payload.pm10.value,\n    temperature: null,\n    humidity: null,\n    pressure: null,\n    source: \"GIOS\"\n};\n\nreturn msg;",
