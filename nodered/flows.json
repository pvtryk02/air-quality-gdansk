    {
        "id": "39d43ad2be36fd56",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Extract PM2.5",
        "func": "const values = msg.payload[\"Lista danych pomiarowych\"];\n\nif (!values || values.length === 0) {\n    node.warn(\"Brak danych PM2.5\");\n    return null;\n}\n\nconst latest = values.find(x => x[\"Wartość\"] !== null);\n\nif (!latest) {\n    node.warn(\"Brak poprawnej wartości PM2.5\");\n    return null;\n}\n\nmsg.topic = \"pm25\";\n\nmsg.payload = {\n    value: latest[\"Wartość\"],\n    measured_at: latest[\"Data\"]\n};\n\nreturn msg;",
        "outputs": 1,
