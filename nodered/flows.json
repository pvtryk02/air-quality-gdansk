    {
        "id": "087f2b6fee26c495",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Extract PM10",
        "func": "const values = msg.payload[\"Lista danych pomiarowych\"];\n\nif (!values || values.length === 0) {\n    node.warn(\"Brak danych PM10\");\n    return null;\n}\n\nconst latest = values.find(x => x[\"Wartość\"] !== null);\n\nif (!latest) {\n    node.warn(\"Brak poprawnej wartości PM10\");\n    return null;\n}\n\nmsg.topic = \"pm10\";\n\nmsg.payload = {\n    value: latest[\"Wartość\"],\n    measured_at: latest[\"Data\"]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 520,
        "wires": [
